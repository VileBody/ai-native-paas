[Unit]
Description=Rootless BuildKit for AI-native PaaS workspace
After=network-online.target ai-native-paas-workspace-agent.service
Wants=network-online.target ai-native-paas-workspace-agent.service

[Service]
Type=simple
User=workspace-task
Group=workspace-task
SupplementaryGroups=workspace-shared
Environment=HOME=/home/workspace-task
Environment=XDG_RUNTIME_DIR=/run/workspace-buildkit
Environment=HTTP_PROXY=http://127.0.0.1:18081
Environment=HTTPS_PROXY=http://127.0.0.1:18081
Environment=NO_PROXY=127.0.0.1,localhost
RuntimeDirectory=workspace-buildkit
RuntimeDirectoryMode=0700
ExecStart=/usr/local/bin/rootlesskit --net=slirp4netns --copy-up=/etc --disable-host-loopback /usr/local/bin/buildkitd --addr unix:///run/workspace-buildkit/buildkitd.sock
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/home/workspace-task /run/workspace-buildkit /var/tmp /workspace
UMask=0077

[Install]
WantedBy=multi-user.target
