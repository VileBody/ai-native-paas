project_id                 = 1234567
cozystack_profile          = "off"
transition_from_profile    = "off"
lab_enabled                = false
cost_guard_acknowledgement = ""
runtime_vpc_id             = ""
runtime_router_id          = ""
runtime_gateway_ip         = "192.168.74.4"
runtime_edge_private_ip    = ""
