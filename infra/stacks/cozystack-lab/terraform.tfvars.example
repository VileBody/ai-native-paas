bootstrap_runner_ssh_key_ids  = []
bootstrap_runner_preset_id    = 5943
bootstrap_bundle_url          = ""
bootstrap_bundle_sha256       = ""
bootstrap_bundle_passphrase   = ""
bootstrap_evidence_upload_url = ""
bootstrap_bundle_generation   = 0
talos_bootstrap_dnat_enabled  = false
talos_bootstrap_source_cidr   = ""
talos_disk_repair_ssh_enabled     = false
talos_disk_repair_ssh_source_cidr = ""

# The default installer is the digest-pinned Cozystack v1.5 Talos build.
# Override only when deliberately upgrading the release lock.
# `off` is the default and plans zero provider actions against an empty state.
# A non-zero profile requires lab_enabled=true, the reviewed outputs from the
# network-foundation state, an exact acknowledgement and transition_from_profile="off".
# Use provider_gate_full only for short release-window managed Redis/Bucket and
# backup/restore evidence; return through off immediately after collecting it.

# Supply state_passphrase through TF_VAR_state_passphrase.
