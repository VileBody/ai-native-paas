{
  "$id": "https://platform.example.com/contracts/mcp/v1/platform_apply_repository_patch.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "base_commit_sha": {
      "maxLength": 64,
      "minLength": 7,
      "pattern": "^[0-9a-fA-F]{7,64}$",
      "type": "string"
    },
    "branch": {
      "description": "A second server-side validator enforces the full safe Git ref subset.",
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,254}$",
      "type": "string"
    },
    "files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "maxLength": 1048576,
            "minLength": 0,
            "type": "string"
          },
          "path": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "path",
          "content"
        ],
        "type": "object"
      },
      "maxItems": 1000,
      "minItems": 1,
      "type": "array"
    },
    "message": {
      "maxLength": 500,
      "minLength": 1,
      "type": "string"
    },
    "project_id": {
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "base_commit_sha",
    "branch",
    "message",
    "files"
  ],
  "title": "platform_apply_repository_patch arguments",
  "type": "object"
}
