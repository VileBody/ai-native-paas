{
  "$id": "https://platform.example.com/contracts/mcp/v1/public-error.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "code": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    },
    "details": {
      "type": "object"
    },
    "message": {
      "maxLength": 1024,
      "minLength": 1,
      "type": "string"
    },
    "operation_id": {
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$",
      "type": "string"
    },
    "retryable": {
      "type": "boolean"
    }
  },
  "required": [
    "code",
    "message",
    "retryable"
  ],
  "title": "Public error",
  "type": "object"
}
