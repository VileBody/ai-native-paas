{
  "$id": "https://platform.example.com/contracts/mcp/v1/platform_create_branch.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "base_commit_sha": {
      "maxLength": 64,
      "minLength": 7,
      "pattern": "^[0-9a-fA-F]{7,64}$",
      "type": "string"
    },
    "branch": {
      "description": "A second server-side validator enforces the full safe Git ref subset.",
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,254}$",
      "type": "string"
    },
    "project_id": {
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "branch",
    "base_commit_sha"
  ],
  "title": "platform_create_branch arguments",
  "type": "object"
}
