{
  "$id": "https://platform.example.com/contracts/mcp/v2/workspace_exec.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "argv": {
      "items": {
        "maxLength": 4096,
        "minLength": 0,
        "type": "string"
      },
      "maxItems": 128,
      "minItems": 1,
      "type": "array"
    },
    "credential_leases": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
        "type": "string"
      },
      "maxItems": 64,
      "type": "array"
    },
    "environment_refs": {
      "additionalProperties": {
        "maxLength": 4096,
        "minLength": 0,
        "type": "string"
      },
      "maxProperties": 128,
      "type": "object"
    },
    "kind": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "output_limit_bytes": {
      "maximum": 1073741824,
      "minimum": 1024,
      "type": "integer"
    },
    "serialization_key": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "timeout_seconds": {
      "maximum": 86400,
      "minimum": 1,
      "type": "integer"
    },
    "working_dir": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
      "type": "string"
    },
    "workspace_id": {
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$",
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "argv",
    "timeout_seconds",
    "output_limit_bytes",
    "kind"
  ],
  "title": "workspace_exec arguments",
  "type": "object"
}
