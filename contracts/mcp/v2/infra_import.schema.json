{
  "$id": "https://platform.example.com/contracts/mcp/v2/infra_import.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "address": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "external_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "workspace_id": {
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$",
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "address",
    "external_id"
  ],
  "title": "infra_import arguments",
  "type": "object"
}
