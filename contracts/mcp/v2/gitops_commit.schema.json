{
  "$id": "https://platform.example.com/contracts/mcp/v2/gitops_commit.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_digest": {
      "maxLength": 71,
      "minLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "base_sha": {
      "maxLength": 64,
      "minLength": 40,
      "pattern": "^[0-9a-f]{40,64}$",
      "type": "string"
    },
    "environment": {
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$",
      "type": "string"
    },
    "manifest_digest": {
      "maxLength": 71,
      "minLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "base_sha",
    "environment",
    "artifact_digest",
    "manifest_digest"
  ],
  "title": "gitops_commit arguments",
  "type": "object"
}
