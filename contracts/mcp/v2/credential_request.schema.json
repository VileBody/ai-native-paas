{
  "$id": "https://platform.example.com/contracts/mcp/v2/credential_request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "audience": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "provider": {
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$",
      "type": "string"
    },
    "scopes": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "type": "array"
    },
    "ttl_seconds": {
      "maximum": 3600,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "provider",
    "audience",
    "scopes",
    "ttl_seconds"
  ],
  "title": "credential_request arguments",
  "type": "object"
}
