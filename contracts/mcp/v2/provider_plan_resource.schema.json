{
  "$id": "https://platform.example.com/contracts/mcp/v2/provider_plan_resource.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "parameters": {
      "maxProperties": 256,
      "type": "object"
    },
    "recipe_id": {
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$",
      "type": "string"
    },
    "recipe_version": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "recipe_id",
    "recipe_version",
    "parameters"
  ],
  "title": "provider_plan_resource arguments",
  "type": "object"
}
