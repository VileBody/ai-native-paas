{
  "$id": "https://platform.example.com/contracts/mcp/v2/infra_apply.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "credential_leases": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
        "type": "string"
      },
      "maxItems": 64,
      "type": "array"
    },
    "environment_refs": {
      "additionalProperties": {
        "maxLength": 4096,
        "minLength": 0,
        "type": "string"
      },
      "maxProperties": 128,
      "type": "object"
    },
    "estimate_version": {
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$",
      "type": "string"
    },
    "output_limit_bytes": {
      "maximum": 1073741824,
      "minimum": 1024,
      "type": "integer"
    },
    "plan_hash": {
      "maxLength": 71,
      "minLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "plan_id": {
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$",
      "type": "string"
    },
    "plan_path": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
      "type": "string"
    },
    "reservation_id": {
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$",
      "type": "string"
    },
    "target": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "timeout_seconds": {
      "maximum": 86400,
      "minimum": 1,
      "type": "integer"
    },
    "working_dir": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "plan_hash",
    "estimate_version",
    "reservation_id",
    "target",
    "plan_path"
  ],
  "title": "infra_apply arguments",
  "type": "object"
}
