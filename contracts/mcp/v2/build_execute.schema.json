{
  "$id": "https://platform.example.com/contracts/mcp/v2/build_execute.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "spec": {
      "additionalProperties": false,
      "properties": {
        "definition_path": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
          "type": "string"
        },
        "build_arguments": {
          "additionalProperties": {
            "maxLength": 4096,
            "type": "string"
          },
          "maxProperties": 128,
          "propertyNames": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^\\S(?:.*\\S)?$"
          },
          "type": "object"
        },
        "cache_scope": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "context_root": {
          "maxLength": 4096,
          "pattern": "^(|(?!.*/\\.\\.(?:/|$))(?!/)(?!.*\\\\).+)$",
          "type": "string"
        },
        "driver": {
          "enum": [
            "dockerfile",
            "buildpacks",
            "nix",
            "custom-approved"
          ],
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "network_policy": {
          "enum": [
            "governed",
            "deny-all"
          ],
          "type": "string"
        },
        "network_profile": {
          "enum": [
            "governed",
            "deny-all"
          ],
          "type": "string"
        },
        "platforms": {
          "items": {
            "enum": [
              "linux/amd64",
              "linux/arm64"
            ],
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "type": "array"
        },
        "secret_refs": {
          "items": {
            "maxLength": 63,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$",
            "type": "string"
          },
          "maxItems": 128,
          "type": "array"
        },
        "resource_class": {
          "enum": [
            "small",
            "standard",
            "large"
          ],
          "type": "string"
        },
        "source_sha": {
          "maxLength": 64,
          "minLength": 40,
          "pattern": "^[0-9a-f]{40,64}$",
          "type": "string"
        },
        "source_root": {
          "maxLength": 4096,
          "pattern": "^(|(?!.*/\\.\\.(?:/|$))(?!/)(?!.*\\\\).+)$",
          "type": "string"
        },
        "timeout_seconds": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "source_sha",
        "driver",
        "platforms",
        "timeout_seconds"
      ],
      "type": "object"
    },
    "workspace_id": {
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$",
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "spec"
  ],
  "title": "build_execute arguments",
  "type": "object"
}
