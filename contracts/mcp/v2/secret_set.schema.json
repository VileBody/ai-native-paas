{
  "$id": "https://platform.example.com/contracts/mcp/v2/secret_set.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "name": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9_]{0,127}$",
      "type": "string"
    },
    "value": {
      "maxLength": 65536,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "name",
    "value"
  ],
  "title": "secret_set arguments",
  "type": "object"
}
