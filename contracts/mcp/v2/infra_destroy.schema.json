{
  "$id": "https://platform.example.com/contracts/mcp/v2/infra_destroy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval_grant_id": {
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$",
      "type": "string"
    },
    "estimate_version": {
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$",
      "type": "string"
    },
    "plan_hash": {
      "maxLength": 71,
      "minLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "plan_id": {
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$",
      "type": "string"
    },
    "reservation_id": {
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "plan_hash",
    "estimate_version",
    "reservation_id",
    "approval_grant_id"
  ],
  "title": "infra_destroy arguments",
  "type": "object"
}
