{
  "$id": "https://platform.example.com/contracts/mcp/v2/invocation-response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "oneOf": [
    {
      "not": {
        "required": [
          "result"
        ]
      },
      "required": [
        "operation"
      ]
    },
    {
      "not": {
        "required": [
          "operation"
        ]
      },
      "required": [
        "result"
      ]
    }
  ],
  "properties": {
    "api_version": {
      "const": "agent.platform.example.com/v2"
    },
    "error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "message": {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "type": "object"
    },
    "invocation_id": {
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$",
      "type": "string"
    },
    "operation": {
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$",
          "type": "string"
        },
        "project_id": {
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$",
          "type": "string"
        },
        "state": {
          "enum": [
            "PENDING",
            "RUNNING",
            "WAITING_APPROVAL",
            "WAITING_DEPENDENCY",
            "SUCCEEDED",
            "FAILED",
            "CANCELED"
          ],
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "tenant_id": {
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$",
          "type": "string"
        }
      },
      "required": [
        "operation_id",
        "tenant_id",
        "project_id",
        "state"
      ],
      "type": "object"
    },
    "replayed": {
      "type": "boolean"
    },
    "result": {}
  },
  "required": [
    "api_version",
    "invocation_id",
    "replayed"
  ],
  "title": "Project MCP invocation response",
  "type": "object"
}
