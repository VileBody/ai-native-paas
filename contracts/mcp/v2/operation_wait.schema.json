{
  "$id": "https://platform.example.com/contracts/mcp/v2/operation_wait.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "operation_id": {
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$",
      "type": "string"
    },
    "timeout_seconds": {
      "maximum": 60,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "operation_id"
  ],
  "title": "operation_wait arguments",
  "type": "object"
}
