{
  "info": {
    "title": "AI-native PaaS Agent API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "responses": {
          "200": {
            "description": "healthy"
          }
        }
      }
    },
    "/mcp/v1/invoke": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../mcp/v1/invocation-request.schema.json"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "synchronous result"
          },
          "202": {
            "description": "asynchronous operation"
          },
          "4XX": {
            "description": "stable public error"
          }
        }
      }
    },
    "/mcp/v1/tools": {
      "get": {
        "responses": {
          "200": {
            "description": "tool catalog"
          }
        }
      }
    },
    "/v1/approval-requests/{request_id}/deny": {
      "post": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "maxLength": 63,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "denied"
          }
        }
      }
    },
    "/v1/approval-requests/{request_id}/grant": {
      "post": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "maxLength": 63,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "grant"
          }
        }
      }
    },
    "/v1/tasks/{task_id}/audit": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "task_id",
            "required": true,
            "schema": {
              "maxLength": 63,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "redacted audit"
          }
        }
      }
    },
    "/v1/tasks/{task_id}/resume": {
      "post": {
        "parameters": [
          {
            "in": "path",
            "name": "task_id",
            "required": true,
            "schema": {
              "maxLength": 63,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "resumed"
          }
        }
      }
    },
    "/v1/tasks/{task_id}/status": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "task_id",
            "required": true,
            "schema": {
              "maxLength": 63,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "task status"
          }
        }
      }
    }
  }
}
