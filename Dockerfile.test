FROM golang:1.25-bookworm@sha256:a9c020ee3d1508c7be5435c262434e3d3fc1d0e76a11afeb9ddae7d60bc86aa4

RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq-dev pkg-config postgresql-client \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY . .

RUN CGO_ENABLED=1 go test -count=1 -tags=postgres_integration ./test/integration -run='^$'

CMD ["go", "test", "-count=1", "./..."]
